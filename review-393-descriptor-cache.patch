+    /// All descriptor fields participate in reuse, even when blob bytes match.
+    #[test]
+    fn decoded_cache_requires_the_full_descriptor() {
+        let budget = DecodeBudget::with_limit(100);
+        let descriptor = Descriptor {
+            digest: Algorithm::Sha256.hash(b"blob"),
+            media_type: crate::oci::layer::TAR_LAYER_MEDIA_TYPE.to_string(),
+            size: 4,
+            annotations: None,
+        };
+        budget.charge(3).unwrap();
+        budget.cache(descriptor.clone(), vec![1, 2, 3]);
+        let remaining = budget.remaining();
+        assert_eq!(*budget.cached(&descriptor).unwrap(), vec![1, 2, 3]);
+        assert!(budget.clone().cached(&descriptor).is_some());
+        assert_eq!(budget.remaining(), remaining, "reuse is not charged again");
+
+        let mut media_type = descriptor.clone();
+        media_type.media_type = crate::oci::layer::TAR_GZIP_LAYER_MEDIA_TYPE.to_string();
+        assert!(budget.cached(&media_type).is_none());
+        let mut size = descriptor.clone();
+        size.size += 1;
+        assert!(budget.cached(&size).is_none());
+        let mut annotations = descriptor;
+        annotations.annotations = Some(BTreeMap::from([(
+            crate::oci::layer::UNCOMPRESSED_DIGEST_ANNOTATION.to_string(),
+            Algorithm::Sha256.hash(b"other").to_string(),
+        )]));
+        assert!(budget.cached(&annotations).is_none());
+    }
